{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify.authoring.v1",
  "description": "Portable authoring that `verify compile` reads, as YAML or JSON. It describes the shape; `verify compile --check` is the authority and also checks references between fields. Query rules (query_zero_rows) are authored as a .sql file instead, which this schema does not describe.",
  "type": "object",
  "required": ["constraint_set_id", "bindings", "rules"],
  "additionalProperties": false,
  "properties": {
    "constraint_set_id": { "type": "string", "pattern": "\\S" },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "description": "The named relations rules refer to; each is bound with --bind NAME=PATH.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_fields": {
            "type": "array",
            "items": { "type": "string", "pattern": "\\S" },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Columns that identify a row; used to report failing rows, and required for binding-qualified predicates."
          }
        }
      }
    },
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "severity", "op"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "\\S", "description": "Unique among the rules." },
        "severity": { "type": "string", "enum": ["error", "warn"] },
        "portability": {
          "type": "string",
          "enum": ["portable", "batch_only"],
          "description": "Optional. If given it must equal what the rule's content implies."
        },
        "op": {
          "type": "string",
          "enum": [
            "unique",
            "not_null",
            "predicate",
            "row_count",
            "aggregate_compare",
            "foreign_key"
          ]
        },
        "binding": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "ref_binding": { "type": "string" },
        "ref_columns": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "expr": { "$ref": "#/$defs/expression" },
        "compare": { "$ref": "#/$defs/comparison" },
        "aggregate": { "$ref": "#/$defs/aggregate" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "enum": ["unique", "not_null"] } } },
          "then": { "required": ["binding", "columns"] }
        },
        {
          "if": { "properties": { "op": { "const": "predicate" } } },
          "then": { "required": ["binding", "expr"] }
        },
        {
          "if": { "properties": { "op": { "const": "row_count" } } },
          "then": { "required": ["binding", "compare"] }
        },
        {
          "if": { "properties": { "op": { "const": "aggregate_compare" } } },
          "then": { "required": ["binding", "aggregate", "compare"] }
        },
        {
          "if": { "properties": { "op": { "const": "foreign_key" } } },
          "then": { "required": ["binding", "columns", "ref_binding", "ref_columns"] }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "description": "Exactly one comparator, with a threshold that is not null, and an optional tolerance.",
      "additionalProperties": false,
      "properties": {
        "eq": {},
        "ne": {},
        "gt": {},
        "gte": {},
        "lt": {},
        "lte": {},
        "tolerance": { "type": "number", "minimum": 0 }
      },
      "oneOf": [
        { "required": ["eq"] },
        { "required": ["ne"] },
        { "required": ["gt"] },
        { "required": ["gte"] },
        { "required": ["lt"] },
        { "required": ["lte"] }
      ]
    },
    "aggregate": {
      "type": "object",
      "description": "Exactly one of sum, avg, min or max, naming a column.",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "sum": { "type": "string", "pattern": "\\S" },
        "avg": { "type": "string", "pattern": "\\S" },
        "min": { "type": "string", "pattern": "\\S" },
        "max": { "type": "string", "pattern": "\\S" }
      }
    },
    "column": {
      "type": "object",
      "required": ["column"],
      "additionalProperties": false,
      "properties": {
        "binding": { "type": "string", "minLength": 1 },
        "column": { "type": "string" }
      }
    },
    "operand": {
      "description": "A column reference or a scalar literal.",
      "anyOf": [
        { "$ref": "#/$defs/column" },
        { "type": ["string", "number", "boolean", "null"] }
      ]
    },
    "expression": {
      "description": "One of: a column reference; eq, ne, gt, gte, lt or lte with two operands; in with a column and a list; and, or with a list of expressions; not with one expression; is_null or is_blank (also written null, blank) with a column reference.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "binding": { "type": "string", "minLength": 1 },
        "column": { "type": "string" },
        "eq": { "$ref": "#/$defs/operands" },
        "ne": { "$ref": "#/$defs/operands" },
        "gt": { "$ref": "#/$defs/operands" },
        "gte": { "$ref": "#/$defs/operands" },
        "lt": { "$ref": "#/$defs/operands" },
        "lte": { "$ref": "#/$defs/operands" },
        "in": { "type": "array", "minItems": 2, "maxItems": 2 },
        "and": { "type": "array", "items": { "$ref": "#/$defs/expression" } },
        "or": { "type": "array", "items": { "$ref": "#/$defs/expression" } },
        "not": { "$ref": "#/$defs/expression" },
        "is_null": { "$ref": "#/$defs/column" },
        "null": { "$ref": "#/$defs/column" },
        "is_blank": { "$ref": "#/$defs/column" },
        "blank": { "$ref": "#/$defs/column" }
      },
      "additionalProperties": false
    },
    "operands": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/operand" }
    }
  }
}
